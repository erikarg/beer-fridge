# Database
# Matches the `db` service in docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/beer_fridge"

# Server
PORT=3000
NODE_ENV=development

# Application
APP_NAME="Beer Fridge API"
APP_VERSION="1.0.0"

# Logging
LOG_LEVEL=info

# Security (optional)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"